# Frappe Vision's hashed bundle output is generated by Bench. Keep source in public/js;
# do not track changing hash names or source maps that make Codespace sync perpetually dirty.
apps/frappe_vision/frappe_vision/public/dist/js/frappe.vision.bundle.*.js
apps/frappe_vision/frappe_vision/public/dist/js/frappe.vision.bundle.*.js.map
