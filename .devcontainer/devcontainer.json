{
  "name": "NDS ERP Saudi — GitHub Codespaces",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "workspaceFolder": "/workspaces/ndserp-sa",
  "remoteUser": "vscode",
  "forwardPorts": [6000, 9000, 6787],
  "portsAttributes": {
    "6000": {
      "label": "NDS ERP Saudi",
      "onAutoForward": "openBrowser"
    },
    "9000": {
      "label": "Frappe Socket.IO",
      "onAutoForward": "silent"
    },
    "6787": {
      "label": "Frappe File Watcher",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ]
    }
  }
}
