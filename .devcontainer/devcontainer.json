{
  "name": "NDS ERP Saudi",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash codespace-bootstrap.sh",
  "postStartCommand": "bash -lc 'mkdir -p logs; (pgrep -af \"codespace-keepalive.sh\" >/dev/null 2>&1 || (nohup bash codespace-keepalive.sh > logs/codespace-keepalive.log 2>&1 < /dev/null &))'",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NDS ERP Saudi",
      "onAutoForward": "openBrowser"
    }
  }
}
