{
  "name": "NDS ERP Saudi",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash codespace-bootstrap.sh",
  "postStartCommand": "bash codespace-poststart.sh",
  "forwardPorts": [8080, 9000],
  "portsAttributes": {
    "8080": {
      "label": "NDS ERP Saudi",
      "onAutoForward": "openBrowser"
    },
    "9000": {
      "label": "NDS ERP Socket.IO",
      "onAutoForward": "silent"
    }
  }
}
