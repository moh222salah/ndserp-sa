 "font_size": 12,
 "html": "<style>\n.opt{font-family:'Segoe UI',Tahoma,Arial,sans-serif;font-size:12px;color:#111}\n.opt h1{font-size:18px;margin:0 0 4px}\n.opt table{width:100%;border-collapse:collapse;margin:6px 0}\n.opt th,.opt td{border:1px solid #999;padding:4px 6px;text-align:start;vertical-align:top}\n.opt th{background:#f0f0f0}\n.opt .num{text-align:end}\n.opt .ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}\n.opt .head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #000;padding-bottom:6px;margin-bottom:8px}\n.opt .box{border:1px solid #999;padding:6px;margin:6px 0}\n.opt .sign{display:flex;justify-content:space-between;margin-top:36px}\n.opt .sign div{width:40%;border-top:1px solid #000;padding-top:4px;text-align:center}\n</style><div class=\"opt\" dir=\"{{ 'rtl' if is_rtl() else 'ltr' }}\">\n<div class=\"head\"><div><h1>{{ _(\"Warranty Certificate\") }}</h1><b class=\"ltr\">{{ doc.name }}</b></div>\n<div>{{ _(\"Status\") }}: <b>{{ _(doc.status) }}</b></div></div>\n<table><tr><th>{{ _(\"Customer\") }}</th><td>{{ frappe.db.get_value(\"Customer\", doc.customer, \"customer_name\") }}</td><th>{{ _(\"Optical Order\") }}</th><td class=\"ltr\">{{ doc.optical_order }}</td></tr>\n<tr><th>{{ _(\"Covered Item\") }}</th><td>{{ frappe.db.get_value(\"Item\", doc.item_code, \"item_name\") }}</td><th>{{ _(\"Warranty Type\") }}</th><td>{{ _(doc.warranty_type) }}</td></tr>\n<tr><th>{{ _(\"Start Date\") }}</th><td class=\"ltr\">{{ frappe.utils.formatdate(doc.start_date) }}</td><th>{{ _(\"End Date\") }}</th><td class=\"ltr\">{{ frappe.utils.formatdate(doc.end_date) }}</td></tr></table>\n<p>{{ _(\"This warranty covers manufacturing defects only and does not cover damage caused by misuse.\") }}</p>\n<div class=\"sign\"><div>{{ _(\"Authorized Signature\") }}</div><div>{{ _(\"Customer\") }}</div></div>\n</div>",
