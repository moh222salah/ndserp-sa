 "doc_type": "Optical Prescription",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 12,
 "html": "<style>\n.opt{font-family:'Segoe UI',Tahoma,Arial,sans-serif;font-size:12px;color:#111}\n.opt h1{font-size:18px;margin:0 0 4px}\n.opt table{width:100%;border-collapse:collapse;margin:6px 0}\n.opt th,.opt td{border:1px solid #999;padding:4px 6px;text-align:start;vertical-align:top}\n.opt th{background:#f0f0f0}\n.opt .num{text-align:end}\n.opt .ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}\n.opt .head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #000;padding-bottom:6px;margin-bottom:8px}\n.opt .box{border:1px solid #999;padding:6px;margin:6px 0}\n.opt .sign{display:flex;justify-content:space-between;margin-top:36px}\n.opt .sign div{width:40%;border-top:1px solid #000;padding-top:4px;text-align:center}\n</style><div class=\"opt\" dir=\"{{ 'rtl' if is_rtl() else 'ltr' }}\">\n{% set ROWS = eye_rows(doc) %}\n<div class=\"head\"><div><h1>{{ _(\"Prescription\") }}</h1><b class=\"ltr\">{{ doc.name }}</b></div>\n<div>{{ _(\"Prescription Date\") }}: <span class=\"ltr\">{{ frappe.utils.formatdate(doc.prescription_date) }}</span>{% if doc.expiry_date %}<br>{{ _(\"Expiry Date\") }}: <span class=\"ltr\">{{ frappe.utils.formatdate(doc.expiry_date) }}</span>{% endif %}</div></div>\n<table><tr><th>{{ _(\"Customer\") }}</th><td>{{ doc.customer_name }}</td><th>{{ _(\"Optician\") }}</th><td>{{ (frappe.db.get_value(\"User\", doc.optician, \"full_name\") if doc.optician else \"\") }}</td></tr></table>\n<table><thead><tr><th></th><th>{{ _(\"Right Eye (OD)\") }}</th><th>{{ _(\"Left Eye (OS)\") }}</th></tr></thead><tbody>\n{% for r in ROWS %}{% if r.od or r.os %}<tr><th>{{ r.label }}</th><td class=\"num\"><span class=\"ltr\">{{ r.od }}</span></td><td class=\"num\"><span class=\"ltr\">{{ r.os }}</span></td></tr>{% endif %}{% endfor %}\n</tbody></table>\n{% if doc.binocular_pd or doc.near_pd %}<table><tr>{% if doc.binocular_pd %}<th>{{ _(\"Binocular PD\") }}</th><td><span class=\"ltr\">{{ doc.binocular_pd }}</span></td>{% endif %}{% if doc.near_pd %}<th>{{ _(\"Near PD\") }}</th><td><span class=\"ltr\">{{ doc.near_pd }}</span></td>{% endif %}</tr></table>{% endif %}\n{% if doc.notes %}<div class=\"box\">{{ doc.notes }}</div>{% endif %}\n<div class=\"sign\"><div>{{ _(\"Optician\") }}</div><div>{{ _(\"Customer\") }}</div></div>\n</div>",
 "idx": 0,
 "line_breaks": 0,
