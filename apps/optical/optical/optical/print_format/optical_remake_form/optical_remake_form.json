 "doctype": "Print Format",
 "font_size": 12,
 "html": "<style>\n.opt{font-family:'Segoe UI',Tahoma,Arial,sans-serif;font-size:12px;color:#111}\n.opt h1{font-size:18px;margin:0 0 4px}\n.opt table{width:100%;border-collapse:collapse;margin:6px 0}\n.opt th,.opt td{border:1px solid #999;padding:4px 6px;text-align:start;vertical-align:top}\n.opt th{background:#f0f0f0}\n.opt .num{text-align:end}\n.opt .ltr{direction:ltr;unicode-bidi:isolate;display:inline-block}\n.opt .head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:2px solid #000;padding-bottom:6px;margin-bottom:8px}\n.opt .box{border:1px solid #999;padding:6px;margin:6px 0}\n.opt .sign{display:flex;justify-content:space-between;margin-top:36px}\n.opt .sign div{width:40%;border-top:1px solid #000;padding-top:4px;text-align:center}\n</style><div class=\"opt\" dir=\"{{ 'rtl' if is_rtl() else 'ltr' }}\">\n<div class=\"head\"><div><h1>{{ _(\"Remake Request\") }}</h1><b class=\"ltr\">{{ doc.name }}</b></div>\n<div>{{ _(\"Status\") }}: <b>{{ _(doc.status) }}</b><br>{{ _(\"Request Date\") }}: <span class=\"ltr\">{{ frappe.utils.formatdate(doc.request_date) }}</span></div></div>\n<table><tr><th>{{ _(\"Customer\") }}</th><td>{{ doc.customer_name }}</td><th>{{ _(\"Original Order\") }}</th><td class=\"ltr\">{{ doc.original_order }}</td></tr>\n<tr><th>{{ _(\"Reason\") }}</th><td>{{ _(doc.reason) }}</td><th>{{ _(\"Responsibility\") }}</th><td>{{ _(doc.responsibility) }}</td></tr>\n<tr><th>{{ _(\"Laboratory\") }}</th><td>{{ doc.laboratory or \"\" }}</td><th>{{ _(\"Cost\") }}</th><td class=\"num\">{{ doc.get_formatted(\"cost\") }}</td></tr></table>\n{% if doc.replacement_items %}<table><thead><tr><th>{{ _(\"Item\") }}</th><th>{{ _(\"Role\") }}</th><th>{{ _(\"Quantity\") }}</th></tr></thead><tbody>\n{% for r in doc.replacement_items %}<tr><td>{{ r.item_name or r.item_code }}</td><td>{{ _(r.item_role) }}</td><td class=\"num\"><span class=\"ltr\">{{ r.qty }}</span></td></tr>{% endfor %}</tbody></table>{% endif %}\n{% if doc.notes %}<div class=\"box\">{{ doc.notes }}</div>{% endif %}\n</div>",
 "idx": 0,
 "line_breaks": 0,
