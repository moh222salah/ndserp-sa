+/* VA System — Native Workspace Visual Layer */
+/*
+ * Presentation-only layer for native Frappe Workspace.
+ * No workspace content, data, business logic, authentication,
+ * or interaction logic is modified here.
+ */
+
+#editorjs.desk-page {
+  --amt-workspace-accent: #D4AF37;
+  --amt-workspace-ink: #0A2342;
+  --amt-workspace-blue: #164E8F;
+  --amt-workspace-border: rgba(10, 35, 66, 0.10);
+  --amt-workspace-surface: #FFFFFF;
+  --amt-workspace-muted: #F8FAFC;
+  padding-block: 8px 28px;
+}
+
+#editorjs.desk-page .codex-editor {
+  width: 100%;
+}
+
+#editorjs.desk-page .codex-editor__redactor {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 18px;
+  width: 100%;
+  max-width: 1180px;
+  margin-inline: auto;
+  padding: 6px 8px 20px;
+}
+
+#editorjs.desk-page .codex-editor__redactor > .ce-block {
+  min-width: 0;
+  width: auto;
+  margin: 0;
+}
+
+#editorjs.desk-page .codex-editor__redactor > .ce-block:not(:has(.widget)) {
+  grid-column: 1 / -1;
+}
+
+#editorjs.desk-page .codex-editor__redactor .ce-block:has(.ce-header) {
+  margin-block: 4px 2px;
+}
+
+#editorjs.desk-page .codex-editor__redactor .ce-header {
+  position: relative;
+  margin: 0;
+  padding: 4px 4px 14px;
+  color: var(--amt-workspace-ink);
+  font-size: 1.28rem;
+  font-weight: 700;
+  line-height: 1.5;
+  letter-spacing: -0.01em;
+  text-align: start;
+}
+
+#editorjs.desk-page .codex-editor__redactor .ce-block:has(.ce-header) .ce-header::after {
+  content: "";
+  display: block;
+  width: 42px;
+  height: 3px;
+  margin-top: 10px;
+  border-radius: 999px;
+  background: var(--amt-workspace-accent);
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box {
+  min-height: 92px;
+  margin: 0;
+  padding: 18px;
+  border: 1px solid var(--amt-workspace-border);
+  border-radius: 14px;
+  background: var(--amt-workspace-surface);
+  box-shadow: 0 8px 24px rgba(10, 35, 66, 0.06);
+  transition:
+    transform 0.18s ease,
+    box-shadow 0.18s ease,
+    border-color 0.18s ease;
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box:hover {
+  transform: translateY(-3px);
+  border-color: rgba(212, 175, 55, 0.50);
+  box-shadow: 0 14px 32px rgba(10, 35, 66, 0.10);
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box .widget-head {
+  min-height: 56px;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin: 0;
+  padding: 0;
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box .widget-title {
+  min-width: 0;
+  color: var(--amt-workspace-ink);
+  font-size: 0.98rem;
+  font-weight: 650;
+  line-height: 1.55;
+  text-align: start;
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box .widget-title,
+#editorjs.desk-page .widget.shortcut-widget-box .widget-title * {
+  overflow-wrap: anywhere;
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box svg,
+#editorjs.desk-page .widget.shortcut-widget-box .icon {
+  flex: 0 0 auto;
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box:hover svg,
+#editorjs.desk-page .widget.shortcut-widget-box:hover .icon {
+  color: var(--amt-workspace-accent);
+}
+
+#editorjs.desk-page .widget.shortcut-widget-box .indicator-pill {
+  margin-inline-start: auto;
+}
+
+[data-theme="dark"] #editorjs.desk-page {
+  --amt-workspace-ink: #E5E7EB;
+  --amt-workspace-border: rgba(229, 231, 235, 0.11);
+  --amt-workspace-surface: #111827;
+  --amt-workspace-muted: #0F172A;
+}
+
+[data-theme="dark"] #editorjs.desk-page .widget.shortcut-widget-box {
+  background: var(--amt-workspace-surface);
+  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
+}
+
+[data-theme="dark"] #editorjs.desk-page .widget.shortcut-widget-box:hover {
+  border-color: rgba(212, 175, 55, 0.46);
+  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.30);
+}
+
+@media (max-width: 991px) {
+  #editorjs.desk-page .codex-editor__redactor {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 767px) {
+  #editorjs.desk-page .codex-editor__redactor {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 14px;
+    padding-inline: 2px;
+  }
+
+  #editorjs.desk-page .widget.shortcut-widget-box {
+    min-height: 82px;
+    padding: 15px 16px;
+  }
+
+  #editorjs.desk-page .codex-editor__redactor .ce-header {
+    font-size: 1.12rem;
+  }
+}
